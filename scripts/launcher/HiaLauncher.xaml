                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Text="已导入资料" />
                                        <TextBlock
                                            x:Name="KnowledgeSourcesSummaryText"
                                            Margin="0,3,0,0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="9.5"
                                            Text="支持 md、txt、html、htm、srt、vtt、pdf；删除托管副本不会删除原文件。" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                                        <Button
                                            x:Name="ImportKnowledgeFileButton"
                                            Margin="0,0,7,0"
                                            AutomationProperties.Name="导入本地知识文件"
                                            Content="导入文件"
                                            Style="{StaticResource CompactButtonStyle}"
                                            TabIndex="23" />
                                        <Button
                                            x:Name="ImportKnowledgeFolderButton"
                                            Margin="0,0,7,0"
                                            AutomationProperties.Name="导入本地知识文件夹"
                                            Content="导入文件夹"
                                            Style="{StaticResource CompactButtonStyle}"
                                            TabIndex="24" />
                                        <Button
                                            x:Name="RefreshKnowledgeSourcesButton"
                                            AutomationProperties.Name="刷新已导入资料"
                                            Content="刷新"
                                            Style="{StaticResource CompactButtonStyle}"
                                            TabIndex="25" />
                                    </WrapPanel>
                                </Grid>

                                <ListBox
                                    x:Name="KnowledgeSourcesList"
                                    Height="188"
                                    AutomationProperties.Name="已导入本地知识资料"
                                    SelectionMode="Single"
                                    Style="{StaticResource KnowledgeListBoxStyle}"
                                    TabIndex="26">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding tooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        FontSize="9.5"
                                                        Text="{Binding details}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource AccentCyanBrush}"
                                                    FontSize="9.5"
                                                    Text="{Binding status_label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Margin="0,8,-7,0">
                                    <Button
                                        x:Name="DeleteKnowledgeSourceButton"
                                        Margin="0,0,7,0"
                                        AutomationProperties.Name="删除所选托管知识副本"
                                        Content="删除所选"
                                        IsEnabled="False"
                                        Style="{StaticResource ActionButtonStyle}"
                                        TabIndex="27" />
                                    <Button
                                        x:Name="RescanKnowledgeSourcesButton"
                                        Margin="0,0,7,0"
                                        AutomationProperties.Name="重新扫描托管知识资料"
                                        Content="重新扫描资料"
                                        Style="{StaticResource ActionButtonStyle}"
                                        TabIndex="28" />
                                </WrapPanel>

                                <Border Height="1" Margin="0,17" Background="{StaticResource BorderSoftBrush}" />

                                <Border
                                    x:Name="KnowledgeIndexPanel"
                                    Padding="17,15"
                                    Background="#9B0D1220"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Style="{StaticResource SubtleInteractiveCardStyle}">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="142" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Text="本地知识索引" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Text="MANUAL BUILD" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="4,0,14,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="KnowledgeIndexModelText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Text="尚未读取模型" TextTrimming="CharacterEllipsis" ToolTip="尚未读取模型" />
                                                <TextBlock x:Name="KnowledgeIndexCountText" Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Text="0 / 0" />
                                            </Grid>
                                            <ProgressBar x:Name="KnowledgeIndexProgressBar" Grid.Row="1" Height="5" Margin="0,7,0,0" Background="#252B40" BorderThickness="0" Foreground="{StaticResource AccentCyanBrush}" Maximum="100" Minimum="0" Value="0" />
                                            <TextBlock x:Name="KnowledgeIndexStatusText" Grid.Row="2" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="重新扫描后显示索引进度" TextTrimming="CharacterEllipsis" ToolTip="重新扫描后显示索引进度" />
                                        </Grid>
                                        <Button x:Name="KnowledgeIndexActionButton" Grid.Column="2" MinWidth="132" VerticalAlignment="Center" AutomationProperties.Name="构建或继续本地知识索引" Content="构建/继续索引" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" TabIndex="29" />
                                    </Grid>
                                </Border>

                                <Border Height="1" Margin="0,18" Background="{StaticResource BorderSoftBrush}" />

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Text="项目缓存" />
                                        <TextBlock
                                            x:Name="CacheSummaryText"
                                            Margin="0,3,0,0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="9.5"
                                            Text="只显示 .runtime/cache 下的已知托管分类；清理前会重新校验精确路径。" />
                                    </StackPanel>
                                    <Button
                                        x:Name="RefreshCacheButton"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        AutomationProperties.Name="刷新项目缓存分类"
                                        Content="刷新"
                                        Style="{StaticResource CompactButtonStyle}"
                                        TabIndex="30" />
                                </Grid>

                                <ListBox
                                    x:Name="CacheCategoriesList"
                                    Height="138"
                                    AutomationProperties.Name="可清理的项目缓存分类"
                                    SelectionMode="Extended"
                                    Style="{StaticResource KnowledgeListBoxStyle}"
                                    TabIndex="31">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ToolTip="{Binding tooltip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding label}" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        FontSize="9.5"
                                                        Text="{Binding relative_path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="10"
                                                    Text="{Binding size_label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button
                                    x:Name="CleanupScreenshotsButton"
                                    MinWidth="132"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="清理所选项目缓存"
                                    Content="清理所选缓存"
                                    IsEnabled="False"
                                    Style="{StaticResource ActionButtonStyle}"
                                    TabIndex="32"
                                    ToolTip="只清理列表中经过项目边界验证的已知缓存分类" />

                                <Border Height="1" Margin="0,18" Background="{StaticResource BorderSoftBrush}" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Text="最新报告 / 日志" />
                                    <TextBox x:Name="ReportPathTextBox" Grid.Column="1" AutomationProperties.Name="最新自检报告路径" IsReadOnly="True" Style="{StaticResource FlatTextBoxStyle}" TabIndex="33" Text="尚未生成报告" TextWrapping="NoWrap" ToolTip="尚未生成报告" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="3,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="安装失败时也会在这里显示脱敏日志路径。" />
                                </Grid>

                                <WrapPanel Margin="0,18,-8,-8">
                                    <Button x:Name="RescanButton" Margin="0,0,8,8" AutomationProperties.Name="重新扫描" Content="重新扫描" Style="{StaticResource ActionButtonStyle}" TabIndex="34" />
                                    <Button x:Name="RepairButton" Margin="0,0,8,8" AutomationProperties.Name="自动修复安全项" Content="请先重新扫描" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" TabIndex="35" />
                                    <Button x:Name="OpenReportButton" Margin="0,0,8,8" AutomationProperties.Name="打开最新报告" Content="打开报告" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" TabIndex="36" />
                                    <Button x:Name="CopyReportButton" Margin="0,0,8,8" AutomationProperties.Name="复制报告路径" Content="复制报告路径" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" TabIndex="37" />
                                </WrapPanel>

                                <TextBlock Margin="0,15,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="17" Text="安全修复与资料、索引、缓存命令都只操作项目本地运行环境；最终输出目录、原始资料和 Houdini 工程不属于缓存。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border
                x:Name="FooterBar"
                Grid.Row="3"
                Padding="24,12,24,14"
                Background="#F00A0E18"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Text="准备好后，从这里进入 Houdini" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" Text="红色阻断会禁用启动；黄色提醒仍可继续。" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="LaunchButton"
                        Grid.Column="1"
                        MinWidth="188"
                        AutomationProperties.Name="启动 Houdini"
                        Content="启动 Houdini"
                        IsDefault="True"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                TabIndex="38" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
