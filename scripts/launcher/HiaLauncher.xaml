<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="LauncherWindow"
    Title="Big-Chicken Houdini Intelligence Agent"
    Width="1180"
    Height="820"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    WindowStyle="None"
    AllowsTransparency="False"
    Background="#090C18"
    BorderBrush="#303951"
    BorderThickness="1"
    Foreground="#F4F7FB"
    FontFamily="Segoe UI"
    FontSize="13"
    Language="zh-CN"
    KeyboardNavigation.TabNavigation="Cycle"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <SolidColorBrush x:Key="CardRaisedBrush" Color="#151A28" />
        <SolidColorBrush x:Key="BorderBrush" Color="#39435E" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#272F46" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F6FC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BCC3D6" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#858EA8" />
        <SolidColorBrush x:Key="PickerBackgroundBrush" Color="#0C1020" />
        <SolidColorBrush x:Key="PickerPopupBrush" Color="#0D1222" />
        <SolidColorBrush x:Key="PickerTextBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="PickerSecondaryTextBrush" Color="#BBC7D8" />
        <SolidColorBrush x:Key="PickerDisabledTextBrush" Color="#9BA6B8" />
        <SolidColorBrush x:Key="PickerDisabledBackgroundBrush" Color="#11161E" />
        <SolidColorBrush x:Key="PickerHoverBrush" Color="#1D2942" />
        <SolidColorBrush x:Key="PickerSelectedBrush" Color="#26234B" />
        <SolidColorBrush x:Key="PickerBorderBrush" Color="#485576" />
        <SolidColorBrush x:Key="PickerFocusBrush" Color="#63D9DA" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9A86FF" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#62DFD7" />
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#ED83B6" />
        <SolidColorBrush x:Key="DisabledPrimaryBackgroundBrush" Color="#5B3D29" />
        <SolidColorBrush x:Key="DisabledPrimaryBorderBrush" Color="#9B765E" />
        <SolidColorBrush x:Key="DisabledPrimaryTextBrush" Color="#E1E5EC" />
        <SolidColorBrush x:Key="StatusGreenBrush" Color="#65D19A" />
        <SolidColorBrush x:Key="StatusYellowBrush" Color="#EFC06B" />
        <SolidColorBrush x:Key="StatusRedBrush" Color="#F07A86" />
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8795A9" />
        <SolidColorBrush x:Key="GreenSurfaceBrush" Color="#142820" />
        <SolidColorBrush x:Key="YellowSurfaceBrush" Color="#2B2418" />
        <SolidColorBrush x:Key="RedSurfaceBrush" Color="#2B1920" />
        <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#171D2C" />
        <SolidColorBrush x:Key="RailLineBrush" Color="#394366" />

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFAD65" Offset="0" />
            <GradientStop Color="#F1782C" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F7F4FF" Offset="0" />
            <GradientStop Color="#B9A8FF" Offset="0.55" />
            <GradientStop Color="#73E3DD" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WorkspaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090B17" Offset="0" />
            <GradientStop Color="#0C1020" Offset="0.55" />
            <GradientStop Color="#09171A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111625" Offset="0" />
            <GradientStop Color="#0D131F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleBarGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#101426" Offset="0" />
            <GradientStop Color="#0E1222" Offset="0.58" />
            <GradientStop Color="#0A111C" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ModernThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="ScrollThumb"
                            Margin="2,1"
                            Background="#46546A"
                            CornerRadius="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#60718B" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ScrollThumb" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        IsTabStop="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        IsTabStop="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>

            </Setter>
        </Style>

        <Style x:Key="ModernScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <Style x:Key="PickerChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DarkPickerComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PickerTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PickerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerHoverBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerSelectedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource PickerDisabledTextBrush}" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerDisabledBackgroundBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#2B3147" />
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPickerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PickerTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PickerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7,44,7" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkPickerComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border
                                x:Name="PickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                                <Grid>
                                    <ContentPresenter
                                        x:Name="SelectionPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        IsHitTestVisible="False"
                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                        SnapsToDevicePixels="True" />
                                    <ToggleButton
                                        x:Name="DropDownToggle"
                                        Width="38"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsTabStop="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" CornerRadius="0,9,9,0">
                                                    <Path
                                                        x:Name="DropDownArrow"
                                                        Width="10"
                                                        Height="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0,0 L 5,5 L 10,0 Z"
                                                        Fill="{StaticResource PickerSecondaryTextBrush}"
                                                        Stretch="Fill" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource PickerFocusBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource PickerDisabledTextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="False"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                StaysOpen="False">
                                <Grid
                                    MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        x:Name="PopupChrome"
                                        Padding="6"
                                        Background="{StaticResource PickerPopupBrush}"
                                        BorderBrush="{StaticResource PickerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                        <ScrollViewer
                                            Style="{StaticResource ModernScrollViewerStyle}"
                                            CanContentScroll="True"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                SnapsToDevicePixels="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#18223B" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#7586BC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#18172F" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource PickerDisabledTextBrush}" />
                                <Setter TargetName="PickerBorder" Property="Background" Value="{StaticResource PickerDisabledBackgroundBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#2B3147" />
                                <Setter TargetName="SelectionPresenter" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HoudiniPickerItemTemplate">
            <Grid ToolTip="{Binding path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Foreground="{StaticResource PickerTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding version, StringFormat=Houdini {0}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding path}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BridgePickerItemTemplate">
            <Grid ToolTip="{Binding path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Foreground="{StaticResource PickerTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding source, StringFormat=Bridge Python · {0}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding path}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BackendPickerItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Foreground="{StaticResource PickerTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding display}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding id, StringFormat=backend · {0}}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmbeddingProfilePickerItemTemplate">
            <Grid ToolTip="{Binding tooltip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Foreground="{StaticResource PickerTextBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding display}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding detail}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

        </DataTemplate>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CaptionButtonChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#273047" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#343D57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseCaptionButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#B83E5E" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#902E49" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtleInteractiveCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation
                                DecelerationRatio="0.82"
                                Duration="0:0:0.16"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.006" />
                            <DoubleAnimation
                                DecelerationRatio="0.82"
                                Duration="0:0:0.16"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.006" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation
                                DecelerationRatio="0.76"
                                Duration="0:0:0.14"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1" />
                            <DoubleAnimation
                                DecelerationRatio="0.76"
                                Duration="0:0:0.14"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#64758F" />
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#121722" />
                    <Setter Property="BorderBrush" Value="#3F485C" />
                    <Setter Property="Foreground" Value="#8F99AD" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style x:Key="KnowledgeListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#80131928" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="KnowledgeItemChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KnowledgeItemChrome" Property="Background" Value="#B51A2134" />
                                <Setter TargetName="KnowledgeItemChrome" Property="BorderBrush" Value="#53617B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="KnowledgeItemChrome" Property="Background" Value="#D126234B" />
                                <Setter TargetName="KnowledgeItemChrome" Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KnowledgeItemChrome" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="KnowledgeItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="KnowledgeItemChrome" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnowledgeListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource KnowledgeListBoxItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="#FFC088" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.94" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledPrimaryBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledPrimaryBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledPrimaryTextBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CountCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="14,0,0,0" />
        </Style>

        <DataTemplate x:Key="CheckResultTemplate">
            <Border
                Padding="8,7,2,7"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="2,0,0,0">
                <Expander
                    Background="Transparent"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="False">
                    <Expander.Header>
                        <Grid Margin="0,1,5,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="{Binding StatusBrush}"
                                Focusable="False"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding CheckName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{Binding StatusBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="{Binding StatusText}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="18,7,8,5">
                        <TextBlock
                            Foreground="{StaticResource TextSecondaryBrush}"
                            LineHeight="18"
                            Text="{Binding ResultText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{Binding AdviceBrush}"
                            LineHeight="18"
                            Text="{Binding AdviceText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
        <RadialGradientBrush x:Key="PinkFogBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3AED83B6" Offset="0" />
            <GradientStop Color="#109A86FF" Offset="0.55" />
            <GradientStop Color="#00101424" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="PurpleFogBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#369A86FF" Offset="0" />
            <GradientStop Color="#1262DFD7" Offset="0.62" />
            <GradientStop Color="#00080B11" Offset="1" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101426" Offset="0" />
            <GradientStop Color="#0C1020" Offset="0.56" />
            <GradientStop Color="#151025" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OverviewHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#19192E" Offset="0" />
            <GradientStop Color="#111729" Offset="0.58" />
            <GradientStop Color="#0D2024" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="DarkToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#151A2A" />
            <Setter Property="BorderBrush" Value="#596580" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="Placement" Value="Mouse" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="{TemplateBinding Foreground}"
                                LineHeight="18"
                                Text="{TemplateBinding Content}"
                                TextWrapping="Wrap" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource DarkToolTipStyle}" />

        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="18,0,12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="NavChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="SelectedRail"
                                    Width="3"
                                    Height="22"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    CornerRadius="0,3,3,0" />
                                <Ellipse
                                    x:Name="NavDot"
                                    Grid.Column="1"
                                    Width="7"
                                    Height="7"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="#59637A" />
                                <ContentPresenter
                                    Grid.Column="2"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F4F1FF" />
                                <Setter TargetName="NavChrome" Property="Background" Value="#171C30" />
                                <Setter TargetName="NavDot" Property="Fill" Value="{StaticResource AccentPurpleBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="NavChrome" Property="Background" Value="#29213F" />
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="#594473" />
                                <Setter TargetName="NavChrome" Property="BorderThickness" Value="1" />
                                <Setter TargetName="SelectedRail" Property="Background" Value="{StaticResource AccentPinkBrush}" />
                                <Setter TargetName="NavDot" Property="Fill" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="NavChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryTileStyle" TargetType="Border">
            <Setter Property="Width" Value="208" />
            <Setter Property="MinHeight" Value="88" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="Background" Value="#AC0D1220" />
            <Setter Property="BorderBrush" Value="#303951" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
        </Style>

        <Style x:Key="EnvironmentLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PickerTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PickerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid
        x:Name="LayoutRoot"
        Background="{StaticResource WorkspaceGradientBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="CustomTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="42"
            Panel.ZIndex="10"
            AutomationProperties.Name="Big-Chicken Houdini Intelligence Agent"
            Background="{StaticResource TitleBarGradientBrush}"
            BorderBrush="#283149"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="3"
                        Height="18"
                        Margin="0,0,10,0"
                        Background="{StaticResource AccentPinkBrush}"
                        CornerRadius="2" />
                    <TextBlock
                        x:Name="WindowBrandTitleText"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandGradientBrush}"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="BIG-CHICKEN" />
                    <Border
                        Width="1"
                        Height="13"
                        Margin="10,0"
                        Background="#46506A" />
                    <TextBlock
                        x:Name="WindowBrandSubtitleText"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="10"
                        Text="Houdini Intelligence Agent"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="0,1,2,1"
                    Orientation="Horizontal">
                    <Button
                        x:Name="MinimizeWindowButton"
                        AutomationProperties.Name="最小化窗口"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="最小化">
                        <TextBlock
                            Margin="0,-5,0,0"
                            FontFamily="Segoe UI"
                            FontSize="17"
                            Text="—" />
                    </Button>
                    <Button
                        x:Name="MaximizeWindowButton"
                        AutomationProperties.Name="最大化窗口"
                        Style="{StaticResource CaptionButtonStyle}"
                        ToolTip="最大化">
                        <TextBlock
                            x:Name="MaximizeWindowGlyph"
                            FontFamily="Segoe UI Symbol"
                            FontSize="14"
                            Text="□" />
                    </Button>
                    <Button
                        x:Name="CloseWindowButton"
                        AutomationProperties.Name="关闭窗口"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="关闭">
                        <TextBlock
                            FontFamily="Segoe UI"
                            FontSize="17"
                            Text="×" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Canvas
            Grid.Row="1"
            Grid.ColumnSpan="2"
            ClipToBounds="True"
            IsHitTestVisible="False">
            <Ellipse
                Canvas.Left="-150"
                Canvas.Top="520"
                Width="430"
                Height="360"
                Fill="{StaticResource PinkFogBrush}"
                Opacity="0.25" />
            <Ellipse
                Canvas.Right="-170"
                Canvas.Top="-110"
                Width="510"
                Height="420"
                Fill="{StaticResource PurpleFogBrush}"
                Opacity="0.22" />
        </Canvas>

        <Border
            x:Name="NavigationRail"
            Grid.Row="1"
            Grid.Column="0"
            Background="{StaticResource SidebarGradientBrush}"
            BorderBrush="#293048"
            BorderThickness="0,0,1,0">
            <Grid x:Name="SidebarPanel" Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel AutomationProperties.Name="启动器导航">
                    <TextBlock
                        x:Name="BrandTitleText"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="LAUNCHER"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="BrandSubtitleText"
                        Margin="1,4,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="10"
                        LineHeight="14"
                        Text="环境 · 自检 · 本地知识"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Margin="3,17,0,0"
                    VerticalAlignment="Top"
                    Foreground="#717B94"
                    FontSize="9"
                    FontWeight="SemiBold"
                    Text="WORKSPACE" />

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <RadioButton
                        x:Name="OverviewNavButton"
                        AutomationProperties.Name="概览"
                        Content="概览"
                        GroupName="LauncherNavigation"
                        IsChecked="True"
                        Style="{StaticResource NavigationButtonStyle}"
                        TabIndex="0" />
                    <RadioButton
                        x:Name="EnvironmentNavButton"
                        AutomationProperties.Name="环境"
                        Content="环境"
                        GroupName="LauncherNavigation"
                        Style="{StaticResource NavigationButtonStyle}"
                        TabIndex="1" />
                    <RadioButton
                        x:Name="PreflightNavButton"
                        AutomationProperties.Name="自检"
                        Content="自检"
                        GroupName="LauncherNavigation"
                        Style="{StaticResource NavigationButtonStyle}"
                        TabIndex="2" />
                    <RadioButton
                        x:Name="ReportsSettingsNavButton"
                        AutomationProperties.Name="本地知识"
                        Content="本地知识"
                        GroupName="LauncherNavigation"
                        Style="{StaticResource NavigationButtonStyle}"
                        TabIndex="3" />
                </StackPanel>

                <Border
                    x:Name="RightVisualRail"
                    Grid.Row="3"
                    Width="174"
                    Margin="0,16,0,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                    <Border
                        x:Name="OverallStatusBadge"
                        Padding="12,9"
                        Background="{StaticResource NeutralSurfaceBrush}"
                        BorderBrush="{StaticResource StatusNeutralBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="OverallStatusDot"
                                Width="7"
                                Height="7"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource StatusNeutralBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    x:Name="OverallStatusText"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="等待检查"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="8"
                                    Text="PREFLIGHT STATUS" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="MainShell" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="MainShellHeader"
                Grid.Row="0"
                Padding="28,17,28,14"
                Background="#CC090D18"
                BorderBrush="#252D43"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock
                        x:Name="PageTitleText"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="概览" />
                    <TextBlock
                        x:Name="PageSubtitleText"
                        Margin="0,3,0,0"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="11"
                        Text="启动状态、关键环境与今天的创作入口" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,10,28,0">
                <Border
                    x:Name="BusyPanel"
                    Padding="13,9"
                    Background="{StaticResource NeutralSurfaceBrush}"
                    BorderBrush="#53649B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="正在扫描并检查环境…" />
                        <ProgressBar
                            x:Name="BusyProgressBar"
                            Grid.Column="1"
                            Height="5"
                            Margin="18,0,2,0"
                            VerticalAlignment="Center"
                            Background="#252B40"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentCyanBrush}"
                            IsIndeterminate="True" />
                    </Grid>
                </Border>
                <Border
                    x:Name="InlineStatusBorder"
                    Margin="0,7,0,0"
                    Padding="13,9"
                    Background="{StaticResource NeutralSurfaceBrush}"
                    BorderBrush="{StaticResource StatusNeutralBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="InlineStatusText"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <ScrollViewer
                x:Name="MainScrollViewer"
                Grid.Row="2"
                Style="{StaticResource ModernScrollViewerStyle}">
                <Border
                    x:Name="MainWorkspacePanel"
                    MaxWidth="1040"
                    Margin="28,18,28,22"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0">
                    <Grid x:Name="PageHost">
                        <Grid x:Name="OverviewPage">
                            <StackPanel>
                                <Border
                                    MinHeight="210"
                                    Padding="0"
                                    Background="{StaticResource OverviewHeroGradientBrush}"
                                    BorderBrush="#3C4563"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="18">
                                    <Grid>
                                        <Border
                                            x:Name="OptionalArtworkPanel"
                                            Width="570"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed">
                                            <Image
                                                x:Name="OptionalArtworkImage"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Opacity="0.72"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                SnapsToDevicePixels="True"
                                                Stretch="UniformToFill">
                                                <Image.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                        <GradientStop Color="#3AFFFFFF" Offset="0.18" />
                                                        <GradientStop Color="#D8FFFFFF" Offset="0.42" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="0.68" />
                                                    </LinearGradientBrush>
                                                </Image.OpacityMask>
                                            </Image>
                                        </Border>
                                        <Border IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#F518192E" Offset="0" />
                                                    <GradientStop Color="#EC15182A" Offset="0.42" />
                                                    <GradientStop Color="#C6151725" Offset="0.66" />
                                                    <GradientStop Color="#72101520" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel
                                            MaxWidth="520"
                                            Margin="26,22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Foreground="{StaticResource AccentPinkBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Text="SESSION OVERVIEW" />
                                            <TextBlock
                                                x:Name="OverviewOverallHeadline"
                                                Margin="0,8,0,0"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                FontSize="27"
                                                FontWeight="SemiBold"
                                                LineHeight="34"
                                                Text="等你检查环境"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="OverviewOverallDetail"
                                                Margin="0,8,0,0"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                LineHeight="19"
                                                Text="选择工作环境后，Big-Chicken 会把启动前的关键状态整理在这里。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <WrapPanel Margin="0,16,-12,0">
                                    <Border Style="{StaticResource SummaryTileStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="OverviewHoudiniDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusNeutralBrush}" />
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="HOUDINI" />
                                            </StackPanel>
                                            <TextBlock x:Name="OverviewHoudiniValueText" Grid.Row="1" Margin="0,7,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Text="等待扫描" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="OverviewHoudiniDetailText" Grid.Row="2" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="版本与 hython" TextTrimming="CharacterEllipsis" ToolTip="版本与 hython" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SummaryTileStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="OverviewMcpDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusNeutralBrush}" />
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="MCP BACKEND" />
                                            </StackPanel>
                                            <TextBlock x:Name="OverviewMcpValueText" Grid.Row="1" Margin="0,7,0,0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Text="HIA MCP V2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="OverviewMcpDetailText" Grid.Row="2" Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="等待检查运行时" TextTrimming="CharacterEllipsis" ToolTip="等待检查运行时" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SummaryTileStyle}">
