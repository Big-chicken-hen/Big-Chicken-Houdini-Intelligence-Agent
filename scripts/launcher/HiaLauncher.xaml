<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="LauncherWindow"
    Title="Houdini Intelligence Launcher"
    Width="1100"
    Height="800"
    MinWidth="920"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize"
    Background="#0B0D18"
    Foreground="#EDF1FF"
    FontFamily="Segoe UI"
    FontSize="13"
    Language="zh-CN"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B0D18" />
        <SolidColorBrush x:Key="CardBrush" Color="#141827" />
        <SolidColorBrush x:Key="CardRaisedBrush" Color="#191E31" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343B59" />
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#262C43" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF1FF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB7D3" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#77819E" />
        <SolidColorBrush x:Key="PickerBackgroundBrush" Color="#11172A" />
        <SolidColorBrush x:Key="PickerPopupBrush" Color="#0D1324" />
        <SolidColorBrush x:Key="PickerTextBrush" Color="#F4F7FF" />
        <SolidColorBrush x:Key="PickerSecondaryTextBrush" Color="#B8C3E0" />
        <SolidColorBrush x:Key="PickerDisabledTextBrush" Color="#95A0C2" />
        <SolidColorBrush x:Key="PickerDisabledBackgroundBrush" Color="#101420" />
        <SolidColorBrush x:Key="PickerHoverBrush" Color="#263559" />
        <SolidColorBrush x:Key="PickerSelectedBrush" Color="#3B3264" />
        <SolidColorBrush x:Key="PickerBorderBrush" Color="#526084" />
        <SolidColorBrush x:Key="PickerFocusBrush" Color="#5EE4EF" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8A6CFF" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#4DDBE8" />
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#FF79B8" />
        <SolidColorBrush x:Key="StatusGreenBrush" Color="#58D68D" />
        <SolidColorBrush x:Key="StatusYellowBrush" Color="#F5B94C" />
        <SolidColorBrush x:Key="StatusRedBrush" Color="#FF6F7D" />
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8190B8" />
        <SolidColorBrush x:Key="GreenSurfaceBrush" Color="#182B28" />
        <SolidColorBrush x:Key="YellowSurfaceBrush" Color="#302719" />
        <SolidColorBrush x:Key="RedSurfaceBrush" Color="#321C26" />
        <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#1D2235" />

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B6CFF" Offset="0" />
            <GradientStop Color="#637DFF" Offset="0.5" />
            <GradientStop Color="#42DCE8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1D1934" Offset="0" />
            <GradientStop Color="#151B31" Offset="0.58" />
            <GradientStop Color="#11262D" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171B2C" Offset="0" />
            <GradientStop Color="#121724" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PickerChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="DarkPickerComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PickerTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PickerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerHoverBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerSelectedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#A88CFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource PickerDisabledTextBrush}" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource PickerDisabledBackgroundBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#2B3147" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPickerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PickerTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PickerBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkPickerComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border
                                x:Name="PickerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                                <Grid>
                                    <ContentPresenter
                                        x:Name="SelectionPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        IsHitTestVisible="False"
                                        SnapsToDevicePixels="True" />
                                    <ToggleButton
                                        x:Name="DropDownToggle"
                                        Width="38"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsTabStop="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" CornerRadius="0,9,9,0">
                                                    <Path
                                                        x:Name="DropDownArrow"
                                                        Width="10"
                                                        Height="6"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0,0 L 5,5 L 10,0 Z"
                                                        Fill="{StaticResource PickerSecondaryTextBrush}"
                                                        Stretch="Fill" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource PickerFocusBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="DropDownArrow" Property="Fill" Value="{StaticResource PickerDisabledTextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="False"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                StaysOpen="False">
                                <Grid
                                    MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border
                                        x:Name="PopupChrome"
                                        Padding="6"
                                        Background="{StaticResource PickerPopupBrush}"
                                        BorderBrush="{StaticResource PickerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                        <ScrollViewer
                                            CanContentScroll="True"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                SnapsToDevicePixels="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#18223B" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#7586BC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{StaticResource PickerFocusBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="PickerBorder" Property="Background" Value="#1C2744" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#A88CFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource PickerDisabledTextBrush}" />
                                <Setter TargetName="PickerBorder" Property="Background" Value="{StaticResource PickerDisabledBackgroundBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="#2B3147" />
                                <Setter TargetName="SelectionPresenter" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HoudiniPickerItemTemplate">
            <Grid ToolTip="{Binding path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding version, StringFormat=Houdini {0}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding path}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BridgePickerItemTemplate">
            <Grid ToolTip="{Binding path}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding source, StringFormat=Bridge Python · {0}}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding path}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BackendPickerItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding display}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    Foreground="{StaticResource PickerSecondaryTextBrush}"
                    FontSize="11"
                    Text="{Binding id, StringFormat=backend · {0}}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#20263A" />
            <Setter Property="BorderBrush" Value="#46506F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#7080B5" />
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="#A9EAF3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="21,10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.94" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CountCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171B2A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="13,9" />
        </Style>

        <DataTemplate x:Key="CheckResultTemplate">
            <Border
                Margin="0,0,0,9"
                Padding="14,12"
                Background="#151A29"
                BorderBrush="{Binding BorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="9"
                        Height="9"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{Binding StatusBrush}"
                        Focusable="False"
                        IsHitTestVisible="False" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,1,10,0"
                        Foreground="{Binding StatusBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding StatusText}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding CheckName}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            LineHeight="19"
                            Text="{Binding ResultText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{Binding AdviceBrush}"
                            LineHeight="19"
                            Text="{Binding AdviceText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="22,20,22,10"
            Padding="20,17"
            Background="{StaticResource HeaderGradientBrush}"
            BorderBrush="#4A416D"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Color="#7259D9" Opacity="0.2" ShadowDepth="0" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="HiaLogoMark"
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Focusable="False"
                    IsHitTestVisible="False">
                    <Ellipse Fill="#181B32" Stroke="{StaticResource AccentGradientBrush}" StrokeThickness="2" />
                    <Ellipse Width="48" Height="48" Fill="#242A45" Stroke="#5B6DAB" StrokeThickness="1" />
                    <Viewbox Width="42" Height="42">
                        <Grid Width="48" Height="48">
                            <Path
                                Data="M 10,19 L 14,8 L 23,15 C 27,13 32,13 36,15 L 43,9 L 42,30 C 40,39 34,43 25,43 C 16,43 10,38 8,30 Z"
                                Fill="#171A2B"
                                Stroke="#8F7CFF"
                                StrokeThickness="2" />
                            <Ellipse Width="4" Height="5" Margin="-12,2,0,0" Fill="#4DE2EA" />
                            <Ellipse Width="4" Height="5" Margin="12,2,0,0" Fill="#FF7DBD" />
                            <Path
                                Data="M 20,31 Q 25,35 30,31"
                                Fill="Transparent"
                                Stroke="#DCE7FF"
                                StrokeThickness="1.5" />
                            <Path
                                Data="M 25,13 L 27,9 L 29,13 L 27,17 Z"
                                Fill="#54E5EA" />
                        </Grid>
                    </Viewbox>
                    <Path
                        Width="9"
                        Height="9"
                        Margin="50,2,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Data="M 5,0 L 10,5 L 5,10 L 0,5 Z"
                        Fill="{StaticResource AccentPinkBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="BrandTitleText"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Houdini Intelligence" />
                    <TextBlock
                        x:Name="BrandSubtitleText"
                        Margin="0,5,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="13"
                        Text="HIA 小助手正在守护 Houdini、Bridge、Codex 与 MCP 的启动环境" />
                </StackPanel>

                <Border
                    x:Name="OverallStatusBadge"
                    Grid.Column="2"
                    Margin="18,0,0,0"
                    Padding="13,8"
                    VerticalAlignment="Center"
                    Background="{StaticResource NeutralSurfaceBrush}"
                    BorderBrush="{StaticResource StatusNeutralBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            x:Name="OverallStatusDot"
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource StatusNeutralBrush}" />
                        <TextBlock
                            x:Name="OverallStatusText"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="小助手：等待检查" />
                    </StackPanel>
                </Border>

                <Path
                    Grid.Column="2"
                    Width="14"
                    Height="14"
                    Margin="0,-13,-7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Data="M 7,0 L 9,5 L 14,7 L 9,9 L 7,14 L 5,9 L 0,7 L 5,5 Z"
                    Fill="#7EEAF0"
                    Opacity="0.72"
                    Focusable="False"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="22,0,22,10"
            Style="{StaticResource SectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,13">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="环境选择" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" Text="多版本时请明确选择；更改后需要重新检查。" />
                </StackPanel>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="MCP backend" />
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Style="{StaticResource PickerChromeStyle}">
                    <ComboBox
                        x:Name="McpBackendComboBox"
                        AutomationProperties.Name="MCP backend"
                        IsEditable="False"
                        ItemTemplate="{StaticResource BackendPickerItemTemplate}"
                        Style="{StaticResource DarkPickerComboBoxStyle}"
                        TabIndex="0" />
                </Border>

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="Houdini 版本" />
                <Border Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource PickerChromeStyle}">
                    <ComboBox
                        x:Name="HoudiniComboBox"
                        AutomationProperties.Name="Houdini 版本"
                        IsEditable="False"
                        ItemTemplate="{StaticResource HoudiniPickerItemTemplate}"
                        Style="{StaticResource DarkPickerComboBoxStyle}"
                        TabIndex="1" />
                </Border>
                <Button
                    x:Name="BrowseHoudiniButton"
                    Grid.Row="2"
                    Grid.Column="2"
                    AutomationProperties.Name="浏览 houdini.exe"
                    Content="浏览…"
                    Style="{StaticResource CompactButtonStyle}"
                    TabIndex="2" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    x:Name="HoudiniPathText"
                    Margin="3,6,0,12"
                    Foreground="{StaticResource TextMutedBrush}"
                    FontSize="12"
                    Text="尚未选择 houdini.exe"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="尚未选择 houdini.exe" />

                <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="Bridge Python" />
                <Border Grid.Row="4" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource PickerChromeStyle}">
                    <ComboBox
                        x:Name="BridgePythonComboBox"
                        AutomationProperties.Name="Bridge Python"
                        IsEditable="False"
                        ItemTemplate="{StaticResource BridgePickerItemTemplate}"
                        Style="{StaticResource DarkPickerComboBoxStyle}"
                        TabIndex="3" />
                </Border>
                <Button
                    x:Name="BrowseBridgeButton"
                    Grid.Row="4"
                    Grid.Column="2"
                    AutomationProperties.Name="浏览 Bridge python.exe"
                    Content="浏览…"
                    Style="{StaticResource CompactButtonStyle}"
                    TabIndex="4" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    x:Name="BridgePathText"
                    Margin="3,6,0,0"
                    Foreground="{StaticResource TextMutedBrush}"
                    FontSize="12"
                    Text="尚未选择 Bridge python.exe"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="尚未选择 Bridge python.exe" />

                <TextBlock
                    Grid.Row="6"
                    Margin="0,4,0,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="最终渲染输出目录" />
                <Border
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="0,4,10,0"
                    Background="{StaticResource PickerBackgroundBrush}"
                    BorderBrush="{StaticResource PickerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <TextBox
                        x:Name="RenderOutputTextBox"
                        Padding="11,8"
                        AutomationProperties.Name="最终渲染输出目录"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="{StaticResource AccentCyanBrush}"
                        Foreground="{StaticResource PickerTextBrush}"
                        TabIndex="5"
                        ToolTip="留空时使用项目 .runtime/cache"
                        VerticalContentAlignment="Center" />
                </Border>
                <Button
                    x:Name="BrowseRenderOutputButton"
                    Grid.Row="6"
                    Grid.Column="2"
                    Margin="0,4,0,0"
                    AutomationProperties.Name="选择最终渲染输出目录"
                    Content="选择…"
                    Style="{StaticResource CompactButtonStyle}"
                    TabIndex="6" />
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="3,6,0,0"
                    Foreground="{StaticResource TextMutedBrush}"
                    FontSize="11"
                    Text="最终 EXR、图片、视频、USD、导出和模拟缓存可放在这里；留空时使用项目 .runtime/cache。它与内部截图、预览和临时缓存目录不同。"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="22,0,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="自检摘要" />
                <TextBlock Margin="0,3,22,0" Foreground="{StaticResource TextMutedBrush}" Text="颜色与文字共同标识结果" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource CountCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusGreenBrush}" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="通过 " />
                    <TextBlock x:Name="PassCountText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CountCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusYellowBrush}" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="警告 " />
                    <TextBlock x:Name="WarningCountText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Text="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CountCardStyle}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource StatusRedBrush}" />
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="阻断 " />
                    <TextBlock x:Name="BlockedCountText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" Text="0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="22,0,22,10"
            Padding="14,14,8,6"
            Background="#10131F"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="2,0,0,11"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="自检详情" />
                <Border
                    x:Name="EmptyStateBorder"
                    Grid.Row="1"
                    Margin="0,12,6,12"
                    Padding="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{StaticResource NeutralSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="EmptyStateText"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="等待首次检查…"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,4,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="ChecksListBox"
                        AutomationProperties.Name="自检结果"
                        ItemTemplate="{StaticResource CheckResultTemplate}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="22,0,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="BusyPanel"
                Grid.Row="0"
                Padding="13,10"
                Background="{StaticResource NeutralSurfaceBrush}"
                BorderBrush="#4B5B91"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Text="正在扫描并检查环境…" />
                    <ProgressBar
                        x:Name="BusyProgressBar"
                        Grid.Column="1"
                        Height="5"
                        Margin="15,0,2,0"
                        VerticalAlignment="Center"
                        Background="#252B40"
                        Foreground="{StaticResource AccentCyanBrush}"
                        IsIndeterminate="True" />
                </Grid>
            </Border>
            <Border
                x:Name="InlineStatusBorder"
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="13,9"
                Background="{StaticResource NeutralSurfaceBrush}"
                BorderBrush="{StaticResource StatusNeutralBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="InlineStatusText"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Border
            Grid.Row="5"
            Margin="22,0,22,20"
            Padding="15"
            Background="#121622"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="报告路径" />
                    <Border Grid.Column="1" Background="#0D101A" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="7">
                        <TextBox
                            x:Name="ReportPathTextBox"
                            Padding="9,6"
                            AutomationProperties.Name="最新自检报告路径"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{StaticResource AccentCyanBrush}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            IsReadOnly="True"
                            Text="尚未生成报告"
                            TextWrapping="NoWrap"
                            ToolTip="尚未生成报告" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="RescanButton"
                        Grid.Column="0"
                        AutomationProperties.Name="重新扫描"
                        Content="重新扫描"
                        Style="{StaticResource ActionButtonStyle}"
                        TabIndex="7" />
                    <Button
                        x:Name="RepairButton"
                        Grid.Column="2"
                        AutomationProperties.Name="修复安全项目"
                        Content="修复安全项目"
                        Style="{StaticResource ActionButtonStyle}"
                        TabIndex="8" />
                    <Button
                        x:Name="CleanupScreenshotsButton"
                        Grid.Column="4"
                        AutomationProperties.Name="清理截图缓存"
                        Content="清理截图缓存"
                        Style="{StaticResource ActionButtonStyle}"
                        TabIndex="9"
                        ToolTip="只清理项目 .runtime\cache\screenshots 第一层的 HIA PNG 截图" />
                    <Button
                        x:Name="CopyReportButton"
                        Grid.Column="6"
                        AutomationProperties.Name="复制报告路径"
                        Content="复制报告路径"
                        IsEnabled="False"
                        Style="{StaticResource ActionButtonStyle}"
                        TabIndex="10" />
                    <Button
                        x:Name="LaunchButton"
                        Grid.Column="8"
                        MinWidth="172"
                        AutomationProperties.Name="启动 Houdini"
                        Content="启动 Houdini  ✦"
                        IsDefault="True"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        TabIndex="11" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
