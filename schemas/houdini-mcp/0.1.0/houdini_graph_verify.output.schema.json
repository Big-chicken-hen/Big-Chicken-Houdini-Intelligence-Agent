{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hia:houdini-mcp:0.1.0:houdini_graph_verify:output",
  "title": "houdini_graph_verify output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "ok",
    "hip_session_id",
    "base_scene_revision",
    "scene_revision",
    "idempotency_key",
    "created_nodes",
    "changed_nodes",
    "artifacts",
    "job_id",
    "warnings",
    "structured_error",
    "container_path",
    "graph_digest",
    "verification"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/identifier" },
    "ok": { "type": "boolean" },
    "hip_session_id": { "$ref": "#/$defs/identifier" },
    "base_scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
    "created_nodes": { "$ref": "#/$defs/emptyNodeList" },
    "changed_nodes": { "$ref": "#/$defs/emptyNodeList" },
    "artifacts": { "$ref": "#/$defs/emptyArtifactList" },
    "job_id": { "type": "null" },
    "warnings": { "$ref": "#/$defs/warnings" },
    "structured_error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/structuredError" }
      ]
    },
    "container_path": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/containerPath" }
      ]
    },
    "graph_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "verification": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/verificationResult" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["ok"],
        "properties": { "ok": { "const": true } }
      },
      "then": {
        "properties": {
          "structured_error": { "type": "null" },
          "container_path": { "$ref": "#/$defs/containerPath" },
          "graph_digest": { "$ref": "#/$defs/sha256" },
          "verification": { "$ref": "#/$defs/verificationResult" }
        }
      },
      "else": {
        "properties": {
          "structured_error": { "$ref": "#/$defs/structuredError" },
          "container_path": { "type": "null" },
          "graph_digest": { "type": "null" },
          "verification": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "containerPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 47,
      "pattern": "^/obj/HIA_Table_[A-Za-z0-9][A-Za-z0-9_]{0,31}$"
    },
    "emptyNodeList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "emptyArtifactList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/warning" }
    },
    "errorIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "NAME_CONFLICT",
            "VERIFY_FAILED",
            "MAIN_THREAD_REQUIRED",
            "CAPABILITY_MISMATCH",
            "HOUDINI_UNAVAILABLE",
            "DEADLINE_EXCEEDED"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "errorDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/errorIssue" }
        }
      }
    },
    "structuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "AUTH_REQUIRED",
            "INVALID_ARGUMENT",
            "SCHEMA_INVALID",
            "PERMISSION_DENIED",
            "PATH_SCOPE_VIOLATION",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "DEADLINE_EXCEEDED",
            "NAME_CONFLICT",
            "CAPABILITY_MISMATCH",
            "MAIN_THREAD_REQUIRED",
            "VERIFY_FAILED",
            "BRIDGE_DISCONNECTED",
            "HOUDINI_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/errorDetails" }
      }
    },
    "verificationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "node", "field", "message"],
      "properties": {
        "code": {
          "enum": [
            "MISSING_NODE",
            "UNEXPECTED_NODE",
            "WRONG_NODE_TYPE",
            "WRONG_PARAMETER",
            "MISSING_CONNECTION",
            "UNEXPECTED_CONNECTION",
            "WRONG_DISPLAY_FLAG",
            "WRONG_RENDER_FLAG",
            "COOK_ERROR",
            "DIGEST_MISMATCH"
          ]
        },
        "node": {
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "tabletop_box",
                "leg_front_left",
                "leg_front_right",
                "leg_back_left",
                "leg_back_right",
                "merge_table",
                "OUT_TABLE"
              ]
            }
          ]
        },
        "field": {
          "enum": [
            "structure",
            "type",
            "unit",
            "size",
            "translate",
            "source",
            "target",
            "input",
            "display",
            "render",
            "cook",
            "graph_digest"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "issues"],
      "properties": {
        "ok": { "type": "boolean" },
        "issues": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/verificationIssue" }
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "graph_digest_matches",
        "structure",
        "parameters",
        "connections",
        "flags",
        "cook_errors"
      ],
      "properties": {
        "valid": { "type": "boolean" },
        "graph_digest_matches": {
          "oneOf": [
            { "type": "null" },
            { "type": "boolean" }
          ]
        },
        "structure": { "$ref": "#/$defs/checkResult" },
        "parameters": { "$ref": "#/$defs/checkResult" },
        "connections": { "$ref": "#/$defs/checkResult" },
        "flags": { "$ref": "#/$defs/checkResult" },
        "cook_errors": { "$ref": "#/$defs/checkResult" }
      }
    }
  }
}
