{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hia:houdini-mcp:0.1.0:houdini_scene_info:output",
  "title": "houdini_scene_info output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "ok",
    "hip_session_id",
    "base_scene_revision",
    "scene_revision",
    "idempotency_key",
    "created_nodes",
    "changed_nodes",
    "artifacts",
    "job_id",
    "warnings",
    "structured_error",
    "scene"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/identifier" },
    "ok": { "type": "boolean" },
    "hip_session_id": { "$ref": "#/$defs/identifier" },
    "base_scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
    "created_nodes": { "$ref": "#/$defs/emptyNodeList" },
    "changed_nodes": { "$ref": "#/$defs/emptyNodeList" },
    "artifacts": { "$ref": "#/$defs/emptyArtifactList" },
    "job_id": { "type": "null" },
    "warnings": { "$ref": "#/$defs/warnings" },
    "structured_error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/structuredError" }
      ]
    },
    "scene": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sceneInfo" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["ok"],
        "properties": { "ok": { "const": true } }
      },
      "then": {
        "properties": {
          "structured_error": { "type": "null" },
          "scene": { "$ref": "#/$defs/sceneInfo" }
        }
      },
      "else": {
        "properties": {
          "structured_error": { "$ref": "#/$defs/structuredError" },
          "scene": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "containerPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 47,
      "pattern": "^/obj/HIA_Table_[A-Za-z0-9][A-Za-z0-9_]{0,31}$"
    },
    "emptyNodeList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "emptyArtifactList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/warning" }
    },
    "errorIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "DEADLINE_EXCEEDED",
            "MAIN_THREAD_REQUIRED",
            "CAPABILITY_MISMATCH",
            "HOUDINI_UNAVAILABLE"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "errorDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/errorIssue" }
        }
      }
    },
    "structuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "AUTH_REQUIRED",
            "INVALID_ARGUMENT",
            "SCHEMA_INVALID",
            "PERMISSION_DENIED",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "DEADLINE_EXCEEDED",
            "MAIN_THREAD_REQUIRED",
            "CAPABILITY_MISMATCH",
            "BRIDGE_DISCONNECTED",
            "HOUDINI_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/errorDetails" }
      }
    },
    "sceneInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hip_fingerprint",
        "current_frame",
        "fps",
        "dirty",
        "hia_table_containers",
        "active_hia_container"
      ],
      "properties": {
        "hip_fingerprint": { "$ref": "#/$defs/sha256" },
        "current_frame": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "dirty": { "type": "boolean" },
        "hia_table_containers": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/containerPath" }
        },
        "active_hia_container": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/containerPath" }
          ]
        }
      }
    }
  }
}
