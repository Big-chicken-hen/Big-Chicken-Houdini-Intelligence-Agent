{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hia:houdini-mcp:0.1.0:houdini_graph_apply:output",
  "title": "houdini_graph_apply output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "ok",
    "hip_session_id",
    "base_scene_revision",
    "scene_revision",
    "idempotency_key",
    "created_nodes",
    "changed_nodes",
    "artifacts",
    "job_id",
    "warnings",
    "structured_error",
    "container_path",
    "graph_digest",
    "replay",
    "undo_label",
    "rollback_status",
    "residual_scope"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/identifier" },
    "ok": { "type": "boolean" },
    "hip_session_id": { "$ref": "#/$defs/identifier" },
    "base_scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
    "created_nodes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/approvedCreatedPath" }
    },
    "changed_nodes": { "$ref": "#/$defs/emptyNodeList" },
    "artifacts": { "$ref": "#/$defs/emptyArtifactList" },
    "job_id": { "type": "null" },
    "warnings": { "$ref": "#/$defs/warnings" },
    "structured_error": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/structuredError" }
      ]
    },
    "container_path": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/containerPath" }
      ]
    },
    "graph_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "replay": { "$ref": "#/$defs/replayInfo" },
    "undo_label": { "const": "HIA: Create Table" },
    "rollback_status": {
      "enum": ["not_required", "succeeded", "failed", "indeterminate"]
    },
    "residual_scope": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/approvedCreatedPath" }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["ok"],
        "properties": { "ok": { "const": true } }
      },
      "then": {
        "properties": {
          "structured_error": { "type": "null" },
          "container_path": { "$ref": "#/$defs/containerPath" },
          "graph_digest": { "$ref": "#/$defs/sha256" },
          "rollback_status": { "const": "not_required" },
          "residual_scope": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "structured_error": { "$ref": "#/$defs/structuredError" },
          "graph_digest": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "required": ["ok", "replay"],
        "properties": {
          "ok": { "const": true },
          "replay": {
            "required": ["replayed"],
            "properties": { "replayed": { "const": false } }
          }
        }
      },
      "then": {
        "properties": { "created_nodes": { "minItems": 8, "maxItems": 8 } }
      }
    },
    {
      "if": {
        "required": ["replay"],
        "properties": {
          "replay": {
            "required": ["replayed"],
            "properties": { "replayed": { "const": true } }
          }
        }
      },
      "then": {
        "properties": { "created_nodes": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "required": ["ok", "rollback_status"],
        "properties": {
          "ok": { "const": false },
          "rollback_status": { "enum": ["not_required", "succeeded"] }
        }
      },
      "then": {
        "properties": {
          "container_path": { "type": "null" },
          "created_nodes": { "maxItems": 0 },
          "residual_scope": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "required": ["rollback_status"],
        "properties": { "rollback_status": { "const": "failed" } }
      },
      "then": {
        "properties": {
          "ok": { "const": false },
          "structured_error": {
            "allOf": [
              { "$ref": "#/$defs/structuredError" },
              { "properties": { "code": { "const": "ROLLBACK_FAILED" } } }
            ]
          },
          "container_path": { "$ref": "#/$defs/containerPath" },
          "created_nodes": { "minItems": 1 },
          "residual_scope": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["rollback_status"],
        "properties": { "rollback_status": { "const": "indeterminate" } }
      },
      "then": {
        "properties": {
          "ok": { "const": false },
          "structured_error": {
            "allOf": [
              { "$ref": "#/$defs/structuredError" },
              { "properties": { "code": { "const": "SCENE_STATE_INDETERMINATE" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "containerPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 47,
      "pattern": "^/obj/HIA_Table_[A-Za-z0-9][A-Za-z0-9_]{0,31}$"
    },
    "nodePath": {
      "type": "string",
      "minLength": 26,
      "maxLength": 64,
      "pattern": "^/obj/HIA_Table_[A-Za-z0-9][A-Za-z0-9_]{0,31}/(tabletop_box|leg_front_left|leg_front_right|leg_back_left|leg_back_right|merge_table|OUT_TABLE)$"
    },
    "approvedCreatedPath": {
      "oneOf": [
        { "$ref": "#/$defs/containerPath" },
        { "$ref": "#/$defs/nodePath" }
      ]
    },
    "emptyNodeList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "emptyArtifactList": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/warning" }
    },
    "errorIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "SCHEMA_INVALID",
            "NODE_TYPE_NOT_ALLOWED",
            "PARAMETER_NOT_ALLOWED",
            "TOPOLOGY_NOT_ALLOWED",
            "PATH_SCOPE_VIOLATION",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "IDEMPOTENCY_CONFLICT",
            "NAME_CONFLICT",
            "MAIN_THREAD_REQUIRED",
            "CAPABILITY_MISMATCH",
            "HOUDINI_UNAVAILABLE",
            "COOK_FAILED",
            "DEADLINE_EXCEEDED"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "errorDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issues"],
      "properties": {
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/errorIssue" }
        }
      }
    },
    "structuredError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "AUTH_REQUIRED",
            "REQUEST_TOO_LARGE",
            "TOOL_NOT_ALLOWED",
            "INVALID_ARGUMENT",
            "SCHEMA_INVALID",
            "PERMISSION_DENIED",
            "NODE_TYPE_NOT_ALLOWED",
            "PARAMETER_NOT_ALLOWED",
            "TOPOLOGY_NOT_ALLOWED",
            "PATH_SCOPE_VIOLATION",
            "APPROVAL_REQUIRED",
            "APPROVAL_DENIED",
            "APPROVAL_EXPIRED",
            "APPROVAL_MISMATCH",
            "HIP_SESSION_MISMATCH",
            "SCENE_CONFLICT",
            "WRITE_IN_PROGRESS",
            "IDEMPOTENCY_CONFLICT",
            "NAME_CONFLICT",
            "MAIN_THREAD_REQUIRED",
            "CAPABILITY_MISMATCH",
            "DEADLINE_EXCEEDED",
            "COOK_FAILED",
            "ROLLBACK_FAILED",
            "SCENE_STATE_INDETERMINATE",
            "BRIDGE_DISCONNECTED",
            "HOUDINI_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "#/$defs/errorDetails" }
      }
    },
    "replayInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "replayed", "original_request_id"],
      "properties": {
        "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
        "replayed": { "type": "boolean" },
        "original_request_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["replayed"],
            "properties": { "replayed": { "const": true } }
          },
          "then": {
            "properties": { "original_request_id": { "$ref": "#/$defs/identifier" } }
          },
          "else": {
            "properties": { "original_request_id": { "type": "null" } }
          }
        }
      ]
    }
  }
}
