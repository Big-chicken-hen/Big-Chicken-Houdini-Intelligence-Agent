{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hia:houdini-mcp:0.1.0:houdini_graph_verify:input",
  "title": "houdini_graph_verify input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "thread_id",
    "turn_id",
    "hip_session_id",
    "base_scene_revision",
    "idempotency_key",
    "deadline_ms",
    "permission_level",
    "parent",
    "container_name",
    "verification_profile",
    "expected_graph_digest"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/identifier" },
    "thread_id": { "$ref": "#/$defs/identifier" },
    "turn_id": { "$ref": "#/$defs/identifier" },
    "hip_session_id": { "$ref": "#/$defs/identifier" },
    "base_scene_revision": { "$ref": "#/$defs/sceneRevision" },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
    "deadline_ms": { "$ref": "#/$defs/deadlineMs" },
    "permission_level": { "const": "scene_read" },
    "parent": { "const": "/obj" },
    "container_name": { "$ref": "#/$defs/containerName" },
    "verification_profile": { "const": "p2_v_table_0.1.0" },
    "expected_graph_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{15,127}$"
    },
    "sceneRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "deadlineMs": {
      "description": "Single-entry execution budget. The trusted Bridge envelope converts it once to an absolute monotonic deadline that downstream hops cannot reset.",
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "containerName": {
      "type": "string",
      "minLength": 11,
      "maxLength": 42,
      "pattern": "^HIA_Table_[A-Za-z0-9][A-Za-z0-9_]{0,31}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
