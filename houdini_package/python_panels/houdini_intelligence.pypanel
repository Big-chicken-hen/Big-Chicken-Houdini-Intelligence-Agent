<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="houdini_intelligence" label="Houdini Intelligence" icon="MISC_python">
    <script><![CDATA[from hia_panel.panel import HoudiniIntelligencePanel


def onCreateInterface():
    # Import Houdini only inside its Python Panel environment, then inject the
    # module into the bounded read-only adapter.
    import hou

    return HoudiniIntelligencePanel(kwargs.get("paneTab"), hou_module=hou)
]]></script>
    <includeInToolbarMenu menu_position="200" create_separator="true"/>
    <help><![CDATA[Codex conversation client with Gate B2 read-only Houdini capability status. It does not modify the Houdini scene.]]></help>
  </interface>
</pythonPanelDocument>
